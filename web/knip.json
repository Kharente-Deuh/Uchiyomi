{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "vuetify.config.ts",
    "app/pages/**/*.vue",
    "app/layouts/**/*.vue",
    "app/middleware/**/*.ts",
    "app/components/**/*.vue",
    "app/plugins/**/*.ts",
    "app/composables/**/*.ts",
    "app/**/*.scss"
  ],
  "project": [
    "**/*.{ts,vue,sass,scss}"
  ],
  "ignoreDependencies": [
    "@microsoft/eslint-formatter-sarif",
    "eslint-formatter-checkstyle",
    "ofetch",
    "vitest-environment-nuxt",
    "vue-router",
    "vue-tsc"
  ]
}
